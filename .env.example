# ============================================================================
# SABAH Meetbot — konfiqurasiya şablonu (sirlər boşdur; real dəyərlər .env-dədir).
# Bu fayl sirr saxlayır: chmod 600, git-ə düşmür (.gitignore). Dəyişəndən sonra: make restart
# ============================================================================

# --- Domenlər və portlar ------------------------------------------------------
# DNS: meetbot.sabahos.com və attendee.sabahos.com → serverin IP-si (A record)
# nginx: deploy/nginx/meetbot.sabahos.com.conf (80/443 → aşağıdakı lokal portlar)
MEETBOT_PUBLIC_URL=https://meetbot.sabahos.com
MEETBOT_ALLOWED_HOSTS=meetbot.sabahos.com
MEETBOT_CSRF_TRUSTED_ORIGINS=https://meetbot.sabahos.com
# Admin-ə HTTPS-siz (ssh tunel ilə) girəcəksinizsə false edin.
MEETBOT_SECURE_COOKIES=true
# Hər ikisi yalnız 127.0.0.1-ə bağlanır; serverdə boş olmalıdır.
MEETBOT_PORT=8100
ATTENDEE_DOMAIN=attendee.sabahos.com
ATTENDEE_PORT=8101
TIME_ZONE=Asia/Baku

# --- Claude (sabah-os-web-backend ilə eyni açar) --------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
# Claude imtina etsə, sorğu avtomatik başqa modeldə təkrarlanır (server-side fallback).
ANTHROPIC_FALLBACKS=true
# Xülasənin dili: en | az | ru | tr
MEETBOT_SUMMARY_LANGUAGE=en

# --- Speech-to-text (görüşlər az / ru / en və qarışıq) ------------------------------
# gladia (tövsiyə) | elevenlabs | openai | deepgram | captions (Meet altyazısı, yalnız 1 dil)
MEETBOT_TRANSCRIPTION_PROVIDER=gladia
# Görüşlərdə danışılan dillər; danışanlar arada keçid edə bilər.
MEETBOT_LANGUAGES=az,ru,en
# !!! DOLDURUN: https://app.gladia.io → API keys. Sonra: make stt-keys
GLADIA_API_KEY=
# Alternativ provayder seçsəniz, onun açarı:
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
# Yalnız MEETBOT_TRANSCRIPTION_PROVIDER=captions olanda: az-AZ, ru-RU, en-US
MEETBOT_CAPTION_LANGUAGE=az-AZ
# Xam Attendee transcription_settings JSON (yuxarıdakı presetlərin üzərinə yazır). Adətən boş.
MEETBOT_TRANSCRIPTION_SETTINGS=

# --- Bot ------------------------------------------------------------------------
# Eyni anda neçə görüş (hər biri ~1 CPU, 2 GB RAM).
ATTENDEE_BOT_WORKERS=2
MEETBOT_BOT_NAME=SABAH Notetaker
# Qoşulanda çata yazılır (emoji olmaz).
MEETBOT_JOIN_MESSAGE=Hi, this is SABAH Notetaker. I am transcribing this meeting so everyone gets written notes afterwards.
# none = yalnız transkript; mp3/mp4 = səs/video da saxlanır
MEETBOT_RECORDING_FORMAT=none
MEETBOT_MAX_MEETING_MINUTES=240
MEETBOT_JOIN_EARLY_SECONDS=60
MEETBOT_AUTOMATIC_LEAVE_SETTINGS=
MEETBOT_GOOGLE_MEET_USE_LOGIN=false

# --- Hansı görüşlərə qoşulsun -------------------------------------------------
# all = Meet linki olan bütün görüşlər; tagged = yalnız MEETBOT_JOIN_TAG olanlar
MEETBOT_JOIN_POLICY=all
MEETBOT_JOIN_TAG=#meetbot
MEETBOT_SKIP_TAG=#nobot
MEETBOT_SKIP_PRIVATE=true
MEETBOT_ORGANIZER_ALLOWLIST=
MEETBOT_LOOKAHEAD_MINUTES=30
MEETBOT_SYNC_INTERVAL_SECONDS=60

# --- SABAH.OS bazası (yalnız oxuma rolu) -------------------------------------------
# Rolu yaradın: make sabah-reader-sql | (SABAH.OS Postgres-ində superuser kimi işlədin)
# SABAH.OS Postgres-i bu serverdədirsə host.docker.internal; başqa serverdədirsə onun IP-si.
SABAH_DB_HOST=host.docker.internal
SABAH_DB_PORT=5432
SABAH_DB_NAME=sabah_os_ai_db
SABAH_DB_USER=meetbot_reader
SABAH_DB_PASSWORD=

# --- E-poçt: sabah-os-web-backend-dəki AWS SES göndəricisi (eyni dəyərlər) ------------------
# none | organizer | invitees
MEETBOT_EMAIL_TO=organizer
# Kənar qonaqlara daxili qeydlər getməsin.
MEETBOT_EMAIL_ALLOWED_DOMAINS=sabahhub.com
MEETBOT_EMAIL_FROM=SABAH Meetbot <no-reply@sabahhub.com>
SES_ENDPOINT_URL=email-smtp.eu-central-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USE_TLS=true
SES_REGION=eu-central-1
SES_KEY_ID=
SES_ACCESS_SECRET=
SES_DEFAULT_EMAIL=no-reply@sabahhub.com

# --- Xülasə hazır olanda JSON POST (məs. gələcəkdə SABAH.OS endpoint-i) --------------------
MEETBOT_RESULT_WEBHOOK_URL=
MEETBOT_RESULT_WEBHOOK_SECRET=

# --- Attendee engine -------------------------------------------------------------
ATTENDEE_REF=66c30688a0b58771e359ce732390f042b57d0a6e
# Attendee dashboard-a giriş (poçt göndərilmir, sadəcə login adıdır).
ATTENDEE_ADMIN_EMAIL=meetbot-admin@sabahhub.com
ATTENDEE_ADMIN_PASSWORD=
ATTENDEE_DJANGO_SECRET_KEY=
ATTENDEE_CREDENTIALS_ENCRYPTION_KEY=
# Serverdə ./scripts/bootstrap.sh avtomatik doldurur (Attendee bazasında yaranır):
ATTENDEE_API_KEY=
ATTENDEE_WEBHOOK_SECRET=

# --- Daxili -------------------------------------------------------------------
POSTGRES_PASSWORD=
MEETBOT_SECRET_KEY=
MEETBOT_API_TOKEN=
